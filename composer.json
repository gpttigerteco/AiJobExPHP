{
    "name": "aijobex/php",
    "description": "AI enabled organizational job description management system",
    "type": "project",
    "require": {
        "php": "^8.2",
        "vlucas/phpdotenv": "^5.6"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.5"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/"
        },
        "files": [
            "app/helpers.php"
        ]
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "@php -r \"if (!is_dir('storage/cache')) { mkdir('storage/cache', 0775, true); }\""
        ]
    },
    "minimum-stability": "stable",
    "license": "proprietary"
}
